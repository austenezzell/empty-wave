# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → the "Connect" button at the top of the project dashboard shows all
# three together. Otherwise: Settings → API Keys (older `anon`/`service_role`
# JWTs are under the "Legacy API Keys" tab there).
#
# The URL is just your project ref, which is in the dashboard address bar:
#   supabase.com/dashboard/project/<ref>  ->  https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Newer projects show a publishable key (sb_publishable_...); older ones an
# anon JWT. Either works — set whichever your dashboard gives you.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# NEXT_PUBLIC_SUPABASE_ANON_KEY=   # legacy alternative

# The service_role / secret key. Server-only: it bypasses every storage policy,
# so it must never reach the browser or be prefixed with NEXT_PUBLIC_.
# Newer projects: secret key (sb_secret_...). Older: service_role JWT.
SUPABASE_SECRET_KEY=sb_secret_...
# SUPABASE_SERVICE_ROLE_KEY=       # legacy alternative

# The single shared password for /admin.
ADMIN_PASSWORD=choose-something-long

# Random string used to sign the admin session cookie.
# Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Public origin of the deployed site. Used to build absolute share-image URLs;
# without it link previews point at localhost.
NEXT_PUBLIC_SITE_URL=https://emptywave.example.com

# Optional. Set the same value in Vercel to lock down the daily cron ping.
CRON_SECRET=
